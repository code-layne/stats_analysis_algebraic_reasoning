% ── Fill-in helpers ───────────────────────────────────────────────────────────
\newcommand{\blank}[1]{\underline{\hspace{#1}}}
\newcommand{\writeline}{\vspace{1pt}\noindent\textcolor{linegray}{\hrulefill}\vspace{3pt}}
\newcommand{\writelines}[1]{\foreach \i in {1,...,#1}{\writeline\\}}
% VOCABPAR is enforced HERE, not per-lesson. A bare \noindent is a NO-OP in the
% middle of a paragraph, so a vocabbox that opens with an intro sentence used to
% run that sentence into the first term, and every lesson had to insert
% \par\vspace{2pt} by hand in the blank AND the key. Both term macros now open
% with their own \par, so the collision cannot happen.
%
% Note the trailing \par\addvspace rather than the older \\[Npt]: a \\ immediately
% followed by the next term's \par emits an underfull \hbox per term. Ending the
% paragraph properly is both quieter and correct. Keep \termblanklong and
% \vocabans (saar-key.sty) structurally parallel — they are the blank and the key
% halves of the same vocabulary row.
\newcommand{\termblank}[1]{%
  \par\addvspace{2pt}%
  \noindent\textbf{\textcolor{cerulean}{#1:}}\quad\blank{6.5cm}\\[1pt]%
  \writeline\par\addvspace{2pt}}
\newcommand{\termblanklong}[1]{%
  \par\addvspace{2pt}%
  \noindent\textbf{\textcolor{cerulean}{#1:}}\\[1pt]%
  \writeline\\[1pt]\writeline\par\addvspace{3pt}}

